{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Singulink.Net.IPLocation": "Information"
    }
  },

  "AllowedHosts": "*",

  "IPLocation": {
    "DataDirectory": "../data",
    "AutoUpdate": true
  },

  "RateLimits": {
    "PermitLimit": 50,
    "Window": "00:01:00"
  }
}
