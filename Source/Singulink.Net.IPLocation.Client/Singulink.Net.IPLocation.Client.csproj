<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <PackageTags>ip; geolocation; location; asn; client; server; service; db-ip;</PackageTags>
    <Description>Free .NET IP location client and self-hostable server: the approximate location and network operator of IP addresses.</Description>
    <PackageProjectUrl>https://github.com/Singulink/Singulink.Net.IPLocation</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Link="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Singulink.Net.Http.Api.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Singulink.Net.IPLocation\Singulink.Net.IPLocation.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="PolySharp" PrivateAssets="All" />
  </ItemGroup>

</Project>
