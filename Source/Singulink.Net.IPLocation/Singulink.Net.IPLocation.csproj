<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <PackageTags>ip; geolocation; location; asn; client; server; service; db-ip;</PackageTags>
    <Description>Types shared by the Singulink IP Location client and service: results, attribution, error codes, limits and JSON type info.</Description>
    <PackageProjectUrl>https://github.com/Singulink/Singulink.Net.IPLocation</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Link="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="PolySharp" PrivateAssets="All" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

</Project>
